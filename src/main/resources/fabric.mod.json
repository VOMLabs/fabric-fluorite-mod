{
	"schemaVersion": 1,
	"id": "fluoritemod",
	"version": "${version}",
	"name": "Fluorite",
	"description": "Adds fluorite ore, blocks, and items to Minecraft.",
	"authors": [
		"ItzzMateo"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "Apache-2.0",
	"icon": "assets/fluoritemod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.vomlabs.fluoritemod.FluoriteMod"
		],
		"fabric-datagen": [
			"com.vomlabs.fluoritemod.FluoriteModDataGenerator"
		]
	},
	"mixins": [
		"fluoritemod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}